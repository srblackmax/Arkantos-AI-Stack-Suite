prefix=@PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: bellows
Description: Independent GPLv3 C++20 machine-learning library built on Hyper Math
Version: @VERSION@
Requires: hyper-math
Libs: -L${libdir} -lbellows -lhypermath -pthread
Cflags: -I${includedir} -std=c++20
