#ifndef OBSIDIAN_VERSION_H
#define OBSIDIAN_VERSION_H

/**
 * @file version.h
 * @brief Compile-time and runtime version query declarations for Obsidian.
 */

#define OBSIDIAN_VERSION_MAJOR @OBSIDIAN_VERSION_MAJOR@
#define OBSIDIAN_VERSION_MINOR @OBSIDIAN_VERSION_MINOR@
#define OBSIDIAN_VERSION_PATCH @OBSIDIAN_VERSION_PATCH@
#define OBSIDIAN_VERSION_STRING "@OBSIDIAN_VERSION_STRING@"

#ifdef __cplusplus
namespace obsidian
{

/**
 * @brief Return the human-readable semantic version string of Obsidian.
 * @pre None.
 * @complexity O(1) time and O(1) space.
 */
const char *
version_string (void) noexcept;

/**
 * @brief Return the major version number of Obsidian.
 * @pre None.
 * @complexity O(1) time and O(1) space.
 */
int
version_major (void) noexcept;

/**
 * @brief Return the minor version number of Obsidian.
 * @pre None.
 * @complexity O(1) time and O(1) space.
 */
int
version_minor (void) noexcept;

/**
 * @brief Return the patch version number of Obsidian.
 * @pre None.
 * @complexity O(1) time and O(1) space.
 */
int
version_patch (void) noexcept;

} /* namespace obsidian */
#endif /* __cplusplus */

#endif /* OBSIDIAN_VERSION_H */
