called_from_lib:libllama.so
called_from_lib:libggml.so
called_from_lib:libggml-base.so
called_from_lib:libggml-cpu.so
called_from_lib:libggml-cuda.so
called_from_lib:libgomp.so
called_from_lib:libasound.so
called_from_lib:libespeak-ng.so
called_from_lib:libonnxruntime.so
called_from_lib:libwhisper.so
called_from_lib:libssh2.so
