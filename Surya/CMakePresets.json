{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug Build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SURYA_BUILD_TESTS": "ON",
        "SURYA_BUILD_BENCH": "ON",
        "SURYA_ENABLE_CUDA": "ON",
        "SURYA_USE_SANITIZERS": "OFF",
        "SURYA_USE_TSAN": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release Build (Portable x86-64-v3 + Runtime AVX-512 Dispatch)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SURYA_BUILD_TESTS": "ON",
        "SURYA_BUILD_BENCH": "ON",
        "SURYA_ENABLE_CUDA": "ON",
        "SURYA_BUILD_FAT_NATIVE": "OFF",
        "SURYA_USE_SANITIZERS": "OFF",
        "SURYA_USE_TSAN": "OFF"
      }
    },
    {
      "name": "release-asan",
      "displayName": "Release with AddressSanitizer + UndefinedBehaviorSanitizer",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SURYA_BUILD_TESTS": "ON",
        "SURYA_BUILD_BENCH": "OFF",
        "SURYA_ENABLE_CUDA": "ON",
        "SURYA_USE_SANITIZERS": "ON",
        "SURYA_USE_TSAN": "OFF"
      }
    },
    {
      "name": "release-tsan",
      "displayName": "Release with ThreadSanitizer",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SURYA_BUILD_TESTS": "ON",
        "SURYA_BUILD_BENCH": "OFF",
        "SURYA_ENABLE_CUDA": "ON",
        "SURYA_USE_SANITIZERS": "OFF",
        "SURYA_USE_TSAN": "ON"
      }
    },
    {
      "name": "release-cuda",
      "displayName": "Release with CUDA 12.x Hybrid GPU & Native Host Tuning",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release-cuda",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SURYA_BUILD_TESTS": "ON",
        "SURYA_BUILD_BENCH": "ON",
        "SURYA_ENABLE_CUDA": "ON",
        "SURYA_BUILD_FAT_NATIVE": "ON",
        "CMAKE_CUDA_ARCHITECTURES": "86",
        "SURYA_USE_SANITIZERS": "OFF",
        "SURYA_USE_TSAN": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "jobs": 20
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 20
    },
    {
      "name": "release-asan",
      "configurePreset": "release-asan",
      "jobs": 20
    },
    {
      "name": "release-tsan",
      "configurePreset": "release-tsan",
      "jobs": 20
    },
    {
      "name": "release-cuda",
      "configurePreset": "release-cuda",
      "jobs": 20
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-asan",
      "configurePreset": "release-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-tsan",
      "configurePreset": "release-tsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-cuda",
      "configurePreset": "release-cuda",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
