	-rm -rf src/io/.libs src/io/_libs
	-rm -rf src/loss/.libs src/loss/_libs
	-rm -rf src/metrics/.libs src/metrics/_libs
	-rm -rf src/nn/.libs src/nn/_libs
	-rm -rf src/optim/.libs src/optim/_libs
