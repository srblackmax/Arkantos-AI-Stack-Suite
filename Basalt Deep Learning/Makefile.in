.PRECIOUS: Makefile


.PHONY: bench bench-ci

bench: bench/bench_basalt
	./bench/bench_basalt --json-out=results.json

bench-ci: bench/bench_basalt
	./bench/bench_basalt --json-out=results.json --check-baseline=$(srcdir)/benchmarks/baseline.json

