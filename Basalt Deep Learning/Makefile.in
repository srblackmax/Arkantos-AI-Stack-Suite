	-rm -f bench/$(DEPDIR)/bench_basalt.Po
	-rm -f examples/$(DEPDIR)/mlp_xor.Po
	-rm -f src/amp/$(DEPDIR)/amp.Plo
	-rm -f src/autograd/$(DEPDIR)/autograd.Plo
	-rm -f src/bellows-compat/$(DEPDIR)/bellows_bridge.Plo
	-rm -f src/c_api/$(DEPDIR)/basalt_c.Plo
	-rm -f src/cli/$(DEPDIR)/basalt_convert.Po
	-rm -f src/cli/$(DEPDIR)/basalt_inspect.Po
	-rm -f src/cli/$(DEPDIR)/basalt_train.Po
	-rm -f src/core/$(DEPDIR)/device.Plo
	-rm -f src/core/$(DEPDIR)/dtype.Plo
	-rm -f src/core/$(DEPDIR)/error.Plo
	-rm -f src/core/$(DEPDIR)/random.Plo
	-rm -f src/core/$(DEPDIR)/version.Plo
	-rm -f src/data/$(DEPDIR)/data.Plo
	-rm -f src/distributed/$(DEPDIR)/distributed.Plo
	-rm -f src/io/$(DEPDIR)/serialization.Plo
	-rm -f src/loss/$(DEPDIR)/loss.Plo
	-rm -f src/metrics/$(DEPDIR)/metrics.Plo
	-rm -f src/nn/$(DEPDIR)/functional.Plo
	-rm -f src/nn/$(DEPDIR)/nn.Plo
	-rm -f src/optim/$(DEPDIR)/optim.Plo
	-rm -f src/optim/$(DEPDIR)/scheduler.Plo
	-rm -f src/tensor/$(DEPDIR)/ops.Plo
	-rm -f src/tensor/$(DEPDIR)/tensor.Plo
	-rm -f src/trainer/$(DEPDIR)/trainer.Plo
	-rm -f tests/$(DEPDIR)/test_phase1_core.Po
	-rm -f tests/$(DEPDIR)/test_phase2_tensor.Po
	-rm -f tests/$(DEPDIR)/test_phase3_autograd.Po
	-rm -f tests/$(DEPDIR)/test_phase4_nn.Po
	-rm -f tests/$(DEPDIR)/test_phase5_optim.Po
	-rm -f tests/$(DEPDIR)/test_phase6_data_amp.Po
	-rm -f tests/$(DEPDIR)/test_phase7_serialization.Po
	-rm -f tests/$(DEPDIR)/test_phase8_trainer.Po
