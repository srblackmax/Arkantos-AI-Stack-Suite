#ifndef BASALT_VERSION_H
#define BASALT_VERSION_H

/* Major, minor, and patch version numbers derived from configure.ac.  */
#define BASALT_VERSION_MAJOR @BASALT_VERSION_MAJOR@
#define BASALT_VERSION_MINOR @BASALT_VERSION_MINOR@
#define BASALT_VERSION_PATCH @BASALT_VERSION_PATCH@
#define BASALT_VERSION_STRING "@BASALT_VERSION_STRING@"

#ifdef __cplusplus
extern "C"
{
#endif

/* Return the library version string (e.g. "0.1.0").  */
const char *
basalt_version_string (void);

/* Return the full human-facing version banner first line
   (e.g. "Basalt Deep Learning 0.1.0").  */
const char *
basalt_version_banner (void);

#ifdef __cplusplus
}

namespace basalt
{

/* Return the C++ library version string derived from AC_INIT.  */
inline const char *
version_string (void) noexcept
{
  return basalt_version_string ();
}

/* Return the full human-facing version banner first line.  */
inline const char *
version_banner (void) noexcept
{
  return basalt_version_banner ();
}

} /* namespace basalt */
#endif

#endif /* BASALT_VERSION_H */
